# ---- wiring profile: local | aws | selfhosted ------------------------------------------
DEPLOYMENT_MODE=local
APP_ENV=dev                        # anything other than "dev" enforces a real SESSION_SECRET
SESSION_SECRET=                    # >= 32 random chars (openssl rand -hex 32) outside dev
SESSION_TTL_SECONDS=3600
API_KEYS_FILE=var/api_keys.json    # create keys with: sa-keys --tenant CMP-101 --role customer

# ---- conversation / session state (SQLite for dev, RDS MySQL in AWS) ---------------------
DATABASE_URL=sqlite:///var/conversations.db
# DATABASE_URL=mysql://user:pass@my-rds-endpoint:3306/support?ssl_ca=/etc/ssl/rds-global-bundle.pem

# ---- retrieval & guardrails ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
CONTEXT_K=3
MIN_CONFIDENCE=                    # blank = per-mode default; calibrate with `sa-eval` (threshold sweep)
HISTORY_TURNS=4

# ---- AWS-managed mode ---------------------------------------------------------------------
AWS_REGION=ap-south-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=                     # 256 | 512 | 1024 for Titan V2 (default 1024)
BEDROCK_LLM_MODEL_ID=              # REQUIRED in aws mode: a model enabled in your account/region
BEDROCK_GUARDRAIL_ID=              # optional Bedrock Guardrails
BEDROCK_GUARDRAIL_VERSION=

# ---- self-hosted mode (vLLM exposes an OpenAI-compatible API) ----------------------------
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
LLM_MODEL=                         # REQUIRED in selfhosted mode, e.g. the model name vLLM serves
EMBED_MODEL=BAAI/bge-m3

# ---- vector store (aws + selfhosted use Qdrant; local uses an in-process NumPy store) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=support_chunks
VECTOR_STORE_PATH=var/vectors
